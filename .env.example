# Application
NODE_ENV=development
PORT=3000

# Database - Supabase PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/api_monitor_db

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRATION=7d

# Monitoring Configuration
# Default timeout for API checks (in milliseconds)
MONITORING_TIMEOUT=5000
# Maximum number of retries for failed checks
MONITORING_RETRIES=3
